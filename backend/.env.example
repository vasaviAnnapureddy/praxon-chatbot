# =============================================================================
# Copy this file to backend/.env and fill in the real values.
# backend/.env is in .gitignore and must NEVER be committed.
# Keep a copy of every real secret in a password manager.
# On Render, these same names go into Environment > Environment Variables.
# =============================================================================

# --- Environment ------------------------------------------------------------
# local | production   (production turns off docs and debug detail)
APP_ENV=local
DEBUG=true

# --- Database (Neon) --------------------------------------------------------
# Neon console > your project > Connection Details > "Pooled connection".
# Use the DEV branch string on your laptop and the PRODUCTION branch string on Render.
# Paste it exactly as Neon gives it, including ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# --- LLM provider -----------------------------------------------------------
# gemini | claude | openai     <- this one value switches the whole app
LLM_PROVIDER=gemini

# Gemini (default). Key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001

# Claude (optional). Key from https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5

# OpenAI (optional). Key from https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Embedding vector size. MUST match the model above and MUST NOT change after
# you have ingested content (the database column is fixed at this width).
# gemini-embedding-001 -> we ask it for 768 (it can do 768, 1536 or 3072)
EMBED_DIM=768

# --- Email alerts (Resend) --------------------------------------------------
# Key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
# Until you verify a domain, Resend only sends FROM onboarding@resend.dev
# and only TO the email you signed up with.
ALERT_FROM_EMAIL=onboarding@resend.dev
ALERT_TO_EMAIL=your-own-email@gmail.com
ALERTS_ENABLED=true

# --- Admin dashboard --------------------------------------------------------
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_SESSION_HOURS=12

# "Continue with Google" for team + client login. Empty = Google button hidden,
# password login still works. From Google Cloud Console -> Credentials ->
# OAuth client ID (Web application). Looks like: 123-abc.apps.googleusercontent.com
# Not a secret (Google sends it to every browser) — but kept here with the rest.
GOOGLE_CLIENT_ID=

# --- Safety / cost caps -----------------------------------------------------
# Hard stop so a public demo link cannot burn the whole API quota in a day.
DAILY_LLM_CALL_CAP=500
# Comma separated origins allowed to embed the widget. * = any (demo only).
ALLOWED_EMBED_ORIGINS=*

# --- Paths (leave as-is unless you move folders) -----------------------------
CLIENT_DIR=../client
FRONTEND_DIST=../frontend/dist
