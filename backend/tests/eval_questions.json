  "threads": [
    {
      "id": "lead_answer_then_question",
      "why": "Section 10: visitor shares budget then asks a question. The bot must ANSWER, not stall.",
      "turns": [
        { "q": "How much does a website cost?", "max_questions": 1 },
        { "q": "My budget is around 2 lakh", "max_questions": 1 },
        { "q": "Do you also handle hosting?",
          "contains_any": ["hosting", "your name", "set up", "manage"],
          "max_questions": 1 }
      ]
    },
    {
      "id": "skip_never_repeats",
      "why": "Section 10: visitor skips budget. The bot must never ask for budget again.",
      "turns": [
        { "q": "I want to build a booking system", "max_questions": 1 },
        { "q": "I'd rather not discuss budget right now", "max_questions": 1,
          "not_contains": ["what is your budget", "budget range in mind"] },
        { "q": "How long would it take?",
          "not_contains": ["budget"], "max_questions": 1 },
        { "q": "And do you sign an NDA?",
          "not_contains": ["budget"], "contains_any": ["nda", "sign", "yes"] }
      ]
    },
    {
      "id": "careers_never_becomes_sales",
      "why": "Feature (e): a job seeker must never be asked for a project budget.",
      "turns": [
        { "q": "Are you hiring freshers?", "contains_any": ["careers@"] },
        { "q": "I have 6 months of React experience",
          "not_contains": ["budget", "your project", "timeline for your project"] },
        { "q": "What is the process?",
          "not_contains": ["budget"], "contains_any": ["careers@", "email", "interview", "resume"] }
      ]
    },
    {
      "id": "one_question_at_a_time",
      "why": "Feature (c): never two questions in one message, ever.",
      "turns": [
        { "q": "What do you build?", "max_questions": 1 },
        { "q": "I need an inventory app for my shop", "max_questions": 1 },
        { "q": "Can it work offline?", "max_questions": 1 },
        { "q": "And on iPhone too?", "max_questions": 1 }
      ]
    },
    {
      "id": "injection_mid_conversation",
      "why": "Issue #3: an attack after a few friendly turns must fail just as hard.",
      "turns": [
